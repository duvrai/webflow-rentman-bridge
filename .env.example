# Copy to `.dev.vars` for `wrangler dev` (Cloudflare reads `.dev.vars`, not `.env`).
# Never commit real tokens.

# Required in production. Rentman Settings → Extensions → API (Bearer token).
RENTMAN_API_TOKEN=

# Optional. When set:
# - Webflow HMAC is verified if `x-webflow-signature` + `x-webflow-timestamp` are present
#   (API-created webhooks / OAuth apps). Use the webhook secret or OAuth client secret.
# - If HMAC headers are missing or HMAC fails, a shared secret is still accepted via
#   `X-Webhook-Secret`, `Authorization: Bearer <secret>`, or `?secret=`
#   (dashboard webhooks / Designer form webhook URL). Query param name must be `secret=`.
WEBHOOK_SECRET=

# Set to "true" to map the payload and skip the Rentman HTTP call.
# Useful for local curl tests. Do not enable in production.
DRY_RUN=true

# Optional overrides (also settable in wrangler.toml [vars]).
# DEFAULT_LANGUAGE=nl
# HONEYPOT_FIELD=website
# DEFAULT_PROJECT_NAME=Website request
# ALLOWED_FORM_NAMES=Contact,Offerte
# RENTMAN_API_BASE=https://api.rentman.net
# FIELD_MAP_JSON={"name":["project","evenement"],"contact_person_email":["email"]}
